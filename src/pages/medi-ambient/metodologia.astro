---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content } from '../../../docs/metodologia-medi-ambient.md';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<BaseLayout title="Metodologia ambiental" description="Criteris de selecció, verificació i auditoria de les iniciatives ambientals" active="medi">
  <article class="article-shell">
    <p><a href={base + 'medi-ambient/'}>← Torna a Medi ambient</a></p>
    <Content />
  </article>
</BaseLayout>
